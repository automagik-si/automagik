#!/bin/sh
# Runs one command under its own memory-capped user scope, so a test, gate or mutant run that
# grows past the cap is killed and reported rather than starving the host or the live team.
#
#   scripts/capped-run [--mem SIZE] [--lock] [--name N] -- COMMAND [ARGS...]
#
#   --mem SIZE   MemoryMax for the scope (default 4G). It only ever raises the cap: a size
#                below the default keeps the default, and anything above 8G is refused.
#   --lock       Take the shared full-gate flock at the main checkout's
#                .automagik/locks/full-gate.lock (a 0700 folder and a 0600 file; never /tmp: a
#                sandboxed pane mounts its own tmpfs there). CAPPED_RUN_LOCK_FILE overrides it
#                for another shared path. The first output line under --lock names the resolved
#                path and its device and inode. One-file runs skip it; full suites take it.
#   --name N     Name the scope unit (a label for `systemctl --user list-units`).
#
# How a run goes:
#   - On a Linux host with cgroup v2, a user manager and systemd-run, the command runs in
#     `systemd-run --user --scope --collect -p MemoryMax=... -p MemorySwapMax=0 -p
#     OOMPolicy=continue`, with `nice -n 10` and `ionice -c 3`. There is no MemoryHigh: the only
#     limit is the kill at MemoryMax (a MemoryHigh would quietly throttle a run that is allowed
#     to reach the cap). OOMPolicy=continue keeps the in-scope monitor alive after the kernel's
#     OOM kill so it can read the cause (the default stop policy kills the monitor first). Before
#     exec the payload raises its own oom_score_adj to 500 (the monitor is forked first and keeps
#     the lower inherited value), so the kernel prefers the payload even when a tmpfs payload's
#     pages are not its RSS. systemd-run execs the command itself, so the wrapper sees the
#     command's exit status and the scope's memory kill (137).
#   - Anywhere else (macOS, CI runners, a distroless image, a failing systemd-run) it runs the
#     command UNCAPPED after one `UNCAPPED: <reason>` line on stderr, and keeps its exit status.
#     A missing cap never fails a gate, and a capped run is never reported as a pass.
#   - CAPPED is claimed only when the kernel says the scope hit its memory limit: the monitor
#     keeps reading the scope's memory.events oom_kill count every tick, so the cause survives
#     the scope. Whenever that count is above zero -- the run's own command or any process in
#     the run -- one line on stderr says `CAPPED: a process in the run was killed at the memory
#     limit (limit=..., peak>=..., last sample ..., command=...)`: `limit=`, the peak floor
#     `peak>=` (a kill means the scope reached MemoryMax, so the measured value is only a lower
#     bound) with the measured `last sample` named, and the command name (the basename only) --
#     never the limit as a bare `peak=` measurement. The command's own exit code passes through
#     (a 137 stays 137; a child that exits 1 stays 1). The line is appended to the run log and
#     read back from it before the wrapper says CAPPED (a log that did not take it is reported
#     as `log=unwritten`), and no argv and no environment value ever reaches that line or the
#     log. A 137 with no oom_kill prints nothing extra. When the monitor wrote its final word with
#     the cause unreadable, the wrapper prints one line `exit 137: could not read the memory-kill
#     cause (scope gone, command=<comm>)`; when the monitor ended before writing its final word,
#     the line is `exit 137: the memory monitor ended before its final read; the run may have hit
#     the memory limit (command=<comm>)`. Both go to the log too, and the command's own exit code
#     passes through. The CAPPED line's text is built by the pure function in
#     `capped-run-wording.sh` next to this script (the tests source it too).
#   - A signal from outside (INT, TERM, HUP) stops this run's own scope and removes its scratch
#     folders and peak file before the wrapper exits.
#   - With --lock, the log also gets one line at the start and one at the end of every run:
#     UTC time, owner (the terminal id in the environment, name only), command name, start or
#     end, and the exit code at the end. The same log always stays 0600.
#   - The command never inherits HC_SCOPE, HC_SOCKET, HC_TERMINAL_SOCKET, HC_SESSION or
#     HC_TERMINAL_ID, and never the real XDG_RUNTIME_DIR: it gets fresh 0700 scratch folders per
#     run for XDG_RUNTIME_DIR and TMPDIR (removed after the run), so a test that starts
#     herdr-core or `hc server` inside a gate cannot reach the live core's sockets. The TMPDIR
#     folder sits under a scratch root outside any git work tree (checked with git rev-parse;
#     another root is tried when it is inside one): a gate runs with TMPDIR outside any git
#     tree, because the herdr suite builds temp homes under it and 70 tests fail inside one.
#     systemd-run itself keeps the real XDG_RUNTIME_DIR to reach the user manager. PATH is
#     untouched (a test's fake-first PATH belongs to the test).
#
# Test-only overrides (never set for a real run): CAPPED_RUN_TEST_MEM replaces the default cap
# (a tiny scope for the cap-kill test), CAPPED_RUN_TEST_STATE overrides the state folder,
# CAPPED_RUN_TEST_LOCK_WAIT overrides the lock wait in seconds, CAPPED_RUN_TEST_UNREADABLE_EVENTS
# makes the monitor report the memory-kill cause unreadable. A real run reads none of them beyond
# that; CAPPED_RUN_LOCK_FILE is the one real override, for another shared lock path.
#
# No release job and no build-host cargo build goes through this wrapper.
#
# Any tool that coordinates through /tmp (lock, pidfile, socket) does not coordinate in a
# sandboxed pane: the pane mounts its own tmpfs there. The full-gate lock is therefore one
# shared path in the main checkout, never /tmp.
#
# Never start herdr-core, `hc server` or any serve in a run without BOTH HC_SESSION=<a unique
# session> and XDG_RUNTIME_DIR=<a scratch folder> set on that command: a second core under the
# same session name retires the live holders.
#
# There is no MemoryHigh on purpose: the only limit is the kill at MemoryMax. A run that needs a
# softer boundary sets MemoryHigh above the measured peak WITH swap, never with swap 0.

# The default cap: 4G, swap 0, no MemoryHigh. CAPPED_RUN_TEST_MEM only exists so a test can ask
# for a tiny scope instead of allocating gigabytes.
default_mem=${CAPPED_RUN_TEST_MEM:-4G}
max_mib=8192
lock_wait_default=3000

say() {
  printf '%s\n' "$*" >&2
}

fail() {
  printf 'capped-run: %s\n' "$*" >&2
  exit 2
}

# The CAPPED text is a pure function in a sibling file: the wrapper calls it with the real
# values, the tests source it and call it with a sample under the limit.
script_dir=$(dirname -- "$0")
script_dir=$( ( unset CDPATH; cd -- "$script_dir" && pwd ) )
[ -r "$script_dir/capped-run-wording.sh" ] ||
  fail 'cannot find capped-run-wording.sh next to this script'
# shellcheck disable=SC1091
. "$script_dir/capped-run-wording.sh"

# Turns a size (4G, 4096M, 512K, any case) into whole MiB in `mib`; fails on anything else.
size_to_mib() {
  case $1 in
    *[kK] | *[mM] | *[gG]) number=${1%?}; unit=${1#"$number"} ;;
    *) return 1 ;;
  esac
  case $number in
    '' | *[!0-9]*) return 1 ;;
    0?*) return 1 ;;
  esac
  case $unit in
    k | K) mib=$(( (number + 1023) / 1024 )) ;;
    m | M) mib=$number ;;
    g | G) mib=$(( number * 1024 )) ;;
    *) return 1 ;;
  esac
  [ "$mib" -gt 0 ] || return 1
  return 0
}

# --- arguments -----------------------------------------------------------------------------

use_lock=0
name=
mem_arg=
while [ $# -gt 0 ]; do
  case $1 in
    --help | -h)
      printf '%s\n' \
        'usage: capped-run [--mem SIZE] [--lock] [--name N] -- COMMAND [ARGS...]' \
        '  --mem SIZE  raise the memory cap (default 4G, ceiling 8G)' \
        '  --lock      take the full-gate lock for the run' \
        '  --name N    name the scope unit'
      exit 0
      ;;
    --mem)
      [ $# -ge 2 ] || fail '--mem needs a size'
      mem_arg=$2
      shift 2
      ;;
    --lock)
      use_lock=1
      shift
      ;;
    --name)
      [ $# -ge 2 ] || fail '--name needs a value'
      name=$2
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *)
      fail "unknown argument: $1 (put the command after --)"
      ;;
  esac
done
[ $# -ge 1 ] || fail 'no command given (use -- <command> [args...])'
[ -n "$1" ] || fail 'the command is empty'

# The owner is the terminal id or pane name in the environment, name only: no other value from
# the environment is read, and the result is a bare token.
owner=${HC_TERMINAL_ID:-${HERDR_PANE_NAME:-}}
owner=$(printf '%s' "$owner" | LC_ALL=C tr -cd 'A-Za-z0-9_.:@+-' | cut -c1-64)
[ -n "$owner" ] || owner=-

# The command's name (comm), never its arguments: only the basename of argv0 is kept.
cmd_comm=${1##*/}
cmd_comm=$(printf '%s' "$cmd_comm" | LC_ALL=C tr -cd 'A-Za-z0-9_.:@+-' | cut -c1-64)
[ -n "$cmd_comm" ] || cmd_comm=-

if ! size_to_mib "$default_mem"; then
  fail "CAPPED_RUN_TEST_MEM is not a size: $default_mem"
fi
default_mib=$mib
[ "$default_mib" -le "$max_mib" ] || fail "the default cap is above the ${max_mib}M ceiling"

mib=$default_mib
if [ -n "$mem_arg" ]; then
  size_to_mib "$mem_arg" || fail "--mem needs a size like 4G, 4096M or 512K"
  if [ "$mib" -gt "$max_mib" ]; then
    fail "--mem ${mem_arg} is above the ${max_mib}M ceiling"
  fi
  if [ "$mib" -le "$default_mib" ]; then
    # Raising only: a smaller size can never lower the cap below the default.
    mib=$default_mib
  fi
fi
stamp=$(date +%s)
unit_name=capped-run-$$-${stamp}
if [ -n "$name" ]; then
  case $name in
    *[!A-Za-z0-9_.-]*) fail '--name may only hold letters, digits, dot, underscore and dash' ;;
  esac
  [ ${#name} -le 60 ] || fail '--name is too long'
  unit_name=capped-run-$name-$$-${stamp}
fi

# --- the run log ---------------------------------------------------------------------------

if [ -n "${CAPPED_RUN_TEST_STATE:-}" ]; then
  state_dir=$CAPPED_RUN_TEST_STATE
elif [ -n "${XDG_STATE_HOME:-}" ]; then
  state_dir=$XDG_STATE_HOME/capped-run
elif [ -n "${HOME:-}" ]; then
  state_dir=$HOME/.local/state/capped-run
else
  state_dir=${TMPDIR:-/tmp}/capped-run
fi
log_file=$state_dir/runs.log

ensure_state() {
  mkdir -p "$state_dir" 2>/dev/null || return 1
  chmod 700 "$state_dir" 2>/dev/null
  return 0
}

ensure_log() {
  ensure_state || return 1
  ( umask 077; : >>"$log_file" ) 2>/dev/null || return 1
  chmod 600 "$log_file" 2>/dev/null
  return 0
}

# One line per event: UTC time, owner, command name, start or end, and the exit code at the end.
log_event() {
  ensure_log || return 0
  printf '%s %s owner=%s comm=%s%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$owner" "$cmd_comm" "${2:-}" \
    >>"$log_file" 2>/dev/null
  return 0
}

# The child's own TMPDIR and runtime folder: fresh 0700 folders under a scratch root outside any
# git work tree. The probe folder picks the root; when it is inside a work tree another candidate
# is tried. Both folders are removed after the run.
scratch_root=
tmp_dir=
runtime_dir=

try_scratch_root() {
  [ -z "${scratch_root:-}" ] || return 0
  [ -n "${1:-}" ] && [ -d "$1" ] || return 1
  probe=$(mktemp -d "$1/capped-run-probe.XXXXXX" 2>/dev/null) || return 1
  chmod 700 "$probe" 2>/dev/null
  if git -C "$probe" rev-parse --show-toplevel >/dev/null 2>&1; then
    rm -rf "${probe:?}" 2>/dev/null
    return 1
  fi
  rm -rf "${probe:?}" 2>/dev/null
  scratch_root=$1
  return 0
}

cleanup_scratch() {
  case ${tmp_dir:-} in
    '') ;;
    "$scratch_root"/capped-run-tmp.*) rm -rf "${tmp_dir:?}" 2>/dev/null ;;
  esac
  case ${runtime_dir:-} in
    '') ;;
    "$scratch_root"/capped-run-rt.*) rm -rf "${runtime_dir:?}" 2>/dev/null ;;
  esac
  return 0
}

# --- capability -----------------------------------------------------------------------------

uncapped_reason=
expand_opt=

# A probe scope with the same properties the real run sets: it proves that this host can start
# a user scope with a memory cap, not merely that systemd-run exists.
probe_run() {
  if command -v timeout >/dev/null 2>&1; then
    timeout 15 systemd-run --user --scope --collect --quiet "$@" \
      -p MemoryMax=64M -p MemorySwapMax=0 -p OOMPolicy=continue true \
      </dev/null >/dev/null 2>&1
  else
    systemd-run --user --scope --collect --quiet "$@" \
      -p MemoryMax=64M -p MemorySwapMax=0 -p OOMPolicy=continue true \
      </dev/null >/dev/null 2>&1
  fi
}

# Newer systemd expands $VARIABLE in a scope's command line; the wrapper's payload (and the tests
# it runs) hold shell code, so the expansion is turned off where systemd-run knows the switch.
# An older systemd-run rejects it and does not expand a scope's command line.
detect_scope() {
  if [ ! -f /sys/fs/cgroup/cgroup.controllers ]; then
    uncapped_reason='no cgroup v2 user scope on this system'
    return 1
  fi
  if ! command -v systemd-run >/dev/null 2>&1; then
    uncapped_reason='systemd-run is not available'
    return 1
  fi
  if probe_run --expand-environment=no; then
    expand_opt=--expand-environment=no
    return 0
  fi
  if probe_run; then
    return 0
  fi
  uncapped_reason='systemd-run could not start a user scope'
  return 1
}

# --- the full-gate lock ---------------------------------------------------------------------

# The lock lives at one shared path in the main checkout, never in /tmp. The main checkout comes
# from the script's own location through git's worktree list, so a linked worktree resolves to
# the checkout it belongs to and never to itself. CAPPED_RUN_LOCK_FILE overrides it for another
# shared path.
shared_lock_file() {
  if [ -n "${CAPPED_RUN_LOCK_FILE:-}" ]; then
    printf '%s' "$CAPPED_RUN_LOCK_FILE"
    return 0
  fi
  main_root=
  if command -v git >/dev/null 2>&1; then
    main_root=$(git -C "$script_dir" worktree list --porcelain 2>/dev/null |
      sed -n 's/^worktree //p' | head -1)
  fi
  [ -n "$main_root" ] || main_root=$(dirname -- "$script_dir")
  printf '%s' "$main_root/.automagik/locks/full-gate.lock"
}

take_lock() {
  lock_file=$(shared_lock_file)
  lock_wait=${CAPPED_RUN_TEST_LOCK_WAIT:-$lock_wait_default}
  case $lock_wait in
    '' | *[!0-9]*) lock_wait=$lock_wait_default ;;
  esac
  lock_dir=${lock_file%/*}
  if [ "$lock_dir" != "$lock_file" ]; then
    ( umask 077; mkdir -p "$lock_dir" ) 2>/dev/null || {
      say "cannot create the full-gate lock folder: $lock_dir"
      return 1
    }
    chmod 700 "$lock_dir" 2>/dev/null
  fi
  if ! command -v flock >/dev/null 2>&1; then
    say 'UNLOCKED: flock is not available; running without the full-gate lock'
    return 0
  fi
  ( umask 077; : >>"$lock_file" ) 2>/dev/null || {
    say "cannot create the full-gate lock file: $lock_file"
    return 1
  }
  chmod 600 "$lock_file" 2>/dev/null
  exec 9>>"$lock_file" || return 1
  if ! flock -w "$lock_wait" 9; then
    say "the full-gate lock is still held after ${lock_wait}s; not starting a second run"
    return 1
  fi
  dev=$(stat -c '%d' "$lock_file" 2>/dev/null)
  ino=$(stat -c '%i' "$lock_file" 2>/dev/null)
  if [ -z "$dev" ] || [ -z "$ino" ]; then
    dev=$(stat -f '%d' "$lock_file" 2>/dev/null)
    ino=$(stat -f '%i' "$lock_file" 2>/dev/null)
  fi
  [ -n "$dev" ] || dev='?'
  [ -n "$ino" ] || ino='?'
  printf 'LOCK: path=%s dev=%s ino=%s\n' "$lock_file" "$dev" "$ino" >&2
  return 0
}

# --- running --------------------------------------------------------------------------------

# Everything the command sees: no live-core variables, and the scope's own runtime directory
# only once the scope has started. The wrapper's own environment is untouched.
have_ionice=0
command -v ionice >/dev/null 2>&1 && have_ionice=1

# The payload runs as a shim so a small monitor can read the scope's memory.peak while the
# promise not to lose the peak still holds: the monitor lives in the scope and keeps the cgroup
# alive until it has written the final value. It only ever writes the peak (and the final
# `done` marker) to the run's state folder, and its stderr is /dev/null: no job-status text from
# the monitor (a `Killed` from one of its children under memory pressure) can reach the wrapper.
# `parent` is the shim's PID, which the exec chain keeps, so the monitor can tell when the
# command has gone.
# shellcheck disable=SC2016
SHIM='
peek=$1
shift
parent=$$
if [ -n "$peek" ]; then
  cg=$(sed -n "s/^0:://p" /proc/self/cgroup 2>/dev/null)
  if [ -n "$cg" ] && [ -r "/sys/fs/cgroup$cg/memory.peak" ]; then
    peakf=/sys/fs/cgroup$cg/memory.peak
    eventsf=/sys/fs/cgroup$cg/memory.events
    (
      exec 2>/dev/null
      umask 077
      peak=
      oom=unknown
      while kill -0 "$parent" 2>/dev/null; do
        p=$(cat "$peakf" 2>/dev/null) || break
        if [ -n "$p" ]; then
          peak=$p
          if [ -z "${CAPPED_RUN_TEST_UNREADABLE_EVENTS:-}" ]; then
            o=$(sed -n "s/^oom_kill //p" "$eventsf" 2>/dev/null)
            [ -n "$o" ] && oom=$o
          fi
          printf "peak %s %s\n" "$p" "$oom" >"$peek.tmp" && mv "$peek.tmp" "$peek"
        fi
        sleep 0.1
      done
      # The final read is explicit: once the payload has ended (the parent is gone), read
      # memory.peak and memory.events once more, then write done; no tick can lose the cause.
      p=$(cat "$peakf" 2>/dev/null)
      [ -n "$p" ] && peak=$p
      if [ -z "${CAPPED_RUN_TEST_UNREADABLE_EVENTS:-}" ]; then
        o=$(sed -n "s/^oom_kill //p" "$eventsf" 2>/dev/null)
        [ -n "$o" ] && oom=$o
      fi
      printf "done %s %s\n" "$peak" "$oom" >"$peek.tmp" && mv "$peek.tmp" "$peek"
    ) &
  fi
fi
# The payload exec path only: the monitor was forked above and keeps the lower inherited
# oom_score_adj, so the kernel prefers this process when the pages of a tmpfs payload are not its RSS.
if [ -w /proc/self/oom_score_adj ]; then
  printf "500\n" > /proc/self/oom_score_adj 2>/dev/null || :
fi
exec "$@"
'

run_systemd() {
  # Extra options come first, then the scope properties, then the payload after --.
  set -- --user --scope --collect --quiet \
    -p "MemoryMax=${mib}M" -p MemorySwapMax=0 -p OOMPolicy=continue -- "$@"
  if [ -n "$unit_name" ]; then
    set -- "--unit=$unit_name" "$@"
  fi
  if [ -n "$expand_opt" ]; then
    set -- "$expand_opt" "$@"
  fi
  exec systemd-run "$@"
}

# The shim, then the payload's own environment: no live-core variables, and fresh TMPDIR and
# XDG_RUNTIME_DIR in place of the real ones (both unset when no scratch folder could be made).
run_capped() {
  if [ "$have_ionice" = 1 ]; then
    set -- sh -c "$SHIM" capped-run-shim "$peek" nice -n 10 ionice -c 3 "$@"
  else
    set -- sh -c "$SHIM" capped-run-shim "$peek" nice -n 10 "$@"
  fi
  if [ -n "$tmp_dir" ] && [ -n "$runtime_dir" ]; then
    set -- env -u HC_SCOPE -u HC_SOCKET -u HC_TERMINAL_SOCKET -u HC_SESSION \
      -u HC_TERMINAL_ID TMPDIR="$tmp_dir" XDG_RUNTIME_DIR="$runtime_dir" "$@"
  else
    set -- env -u HC_SCOPE -u HC_SOCKET -u HC_TERMINAL_SOCKET -u HC_SESSION \
      -u HC_TERMINAL_ID -u TMPDIR -u XDG_RUNTIME_DIR "$@"
  fi
  run_systemd "$@"
}

run_uncapped() {
  if [ "$have_ionice" = 1 ]; then
    set -- nice -n 10 ionice -c 3 "$@"
  else
    set -- nice -n 10 "$@"
  fi
  if [ -n "$tmp_dir" ] && [ -n "$runtime_dir" ]; then
    env -u HC_SCOPE -u HC_SOCKET -u HC_TERMINAL_SOCKET -u HC_SESSION \
      -u HC_TERMINAL_ID TMPDIR="$tmp_dir" XDG_RUNTIME_DIR="$runtime_dir" "$@"
  else
    env -u HC_SCOPE -u HC_SOCKET -u HC_TERMINAL_SOCKET -u HC_SESSION \
      -u HC_TERMINAL_ID -u TMPDIR -u XDG_RUNTIME_DIR "$@"
  fi
}

# Reads the monitor's last value, waiting a bounded moment for its final `done` line.
read_peak() {
  peak=
  oom_state=unknown
  read_done=0
  tries=0
  if [ -n "$peek" ]; then
    while [ "$tries" -lt 30 ]; do
      if [ -r "$peek" ]; then
        if read -r kind bytes oom <"$peek" 2>/dev/null; then
          [ -n "$bytes" ] && peak=$bytes
          if [ "$kind" = "done" ]; then
            # Only the monitor's final word may state the oom_kill count. A tick is not
            # evidence: if the monitor died before its final read, the cause stays unknown.
            read_done=1
            case ${oom:-} in
              '' | unknown | *[!0-9]*) oom_state=unknown ;;
              *) oom_state=$oom ;;
            esac
            return 0
          fi
        fi
      fi
      sleep 0.1
      tries=$((tries + 1))
    done
  fi
  return 0
}

log_capped() {
  capped_line=$1
  ensure_log || return 0
  printf '%s\n' "$capped_line" >>"$log_file" 2>/dev/null
  return 0
}

# --- main -----------------------------------------------------------------------------------

# A signal from outside stops this run's own scope and removes its scratch folders and peak file,
# so a killed wrapper leaves no live scope and nothing behind in the state folder. The body runs
# only from the traps below.
# shellcheck disable=SC2317
on_signal() {
  trap - INT TERM HUP
  [ -n "${unit_name:-}" ] && systemctl --user stop "${unit_name}.scope" >/dev/null 2>&1
  [ -n "${child:-}" ] && kill "$child" 2>/dev/null
  [ "${locked:-0}" = 1 ] && log_event end " exit=$1"
  cleanup_scratch
  [ -n "${peek:-}" ] && rm -f "$peek" "$peek.tmp" 2>/dev/null
  exit "$1"
}
trap 'on_signal 130' INT
trap 'on_signal 143' TERM
trap 'on_signal 129' HUP

locked=0
if [ "$use_lock" = 1 ]; then
  take_lock || exit 2
  locked=1
  log_event start ''
fi

try_scratch_root "${CAPPED_RUN_SCRATCH_ROOT:-}"
try_scratch_root "${TMPDIR:-}"
try_scratch_root /tmp
repo_top=$(git -C "$(pwd)" rev-parse --show-toplevel 2>/dev/null)
[ -n "$repo_top" ] && try_scratch_root "${repo_top%/*}"
try_scratch_root "${HOME:-}/.cache"
ensure_state && try_scratch_root "$state_dir"
if [ -n "$scratch_root" ]; then
  tmp_dir=$(mktemp -d "$scratch_root/capped-run-tmp.XXXXXX" 2>/dev/null) || tmp_dir=
  runtime_dir=$(mktemp -d "$scratch_root/capped-run-rt.XXXXXX" 2>/dev/null) || runtime_dir=
  if [ -z "$tmp_dir" ] || [ -z "$runtime_dir" ]; then
    [ -n "$tmp_dir" ] && rm -rf "${tmp_dir:?}" 2>/dev/null
    [ -n "$runtime_dir" ] && rm -rf "${runtime_dir:?}" 2>/dev/null
    tmp_dir=
    runtime_dir=
  fi
  [ -n "$tmp_dir" ] && chmod 700 "$tmp_dir" 2>/dev/null
  [ -n "$runtime_dir" ] && chmod 700 "$runtime_dir" 2>/dev/null
fi

capped=0
peek=
if detect_scope; then
  capped=1
  if ensure_state; then
    peek=$state_dir/peak.$$
  fi
  run_capped "$@" &
  child=$!
  wait "$child" 2>/dev/null
else
  printf 'UNCAPPED: %s\n' "$uncapped_reason" >&2
  run_uncapped "$@" &
  child=$!
  wait "$child" 2>/dev/null
fi
code=$?

capped_oom=0
if [ "$capped" = 1 ]; then
  read_peak
  case ${oom_state:-} in
    '' | unknown | *[!0-9]*) capped_oom=0 ;;
    *) capped_oom=$oom_state ;;
  esac
fi

if [ "$capped" = 1 ] && [ "$capped_oom" -gt 0 ]; then
  # A kernel-confirmed OOM kill, whether the run's own command or a process it started. One
  # line, with the honest floor and last sample; the command's own exit code passes through.
  # Mutants 15, 18, 19 and 22 break this; the wording, cause and grandchild rows fail.
  limit_bytes=$((mib * 1048576))
  capped_line=$(capped_run_capped_line "$limit_bytes" "${peak:-}" "${peak:-}" "$cmd_comm")
  # Logged and read back BEFORE the wrapper says CAPPED: the report may only claim the log it
  # actually holds. A log that could not take the line is reported honestly.
  log_capped "$capped_line"
  if grep -qxF "$capped_line" "$log_file" 2>/dev/null; then
    printf '%s\n' "$capped_line" >&2
  else
    printf '%s, log=unwritten)\n' "${capped_line%?}" >&2
  fi
elif [ "$capped" = 1 ] && [ "$code" = 137 ] && [ "${oom_state:-}" = unknown ]; then
  # No CAPPED claim without the kernel's word: one honest line, and the log keeps it too.
  if [ "${read_done:-0}" = 1 ]; then
    cause_line=$(printf 'exit 137: could not read the memory-kill cause (scope gone, command=%s)' "$cmd_comm")
  else
    cause_line=$(printf 'exit 137: the memory monitor ended before its final read; the run may have hit the memory limit (command=%s)' "$cmd_comm")
  fi
  printf '%s\n' "$cause_line" >&2
  log_capped "$cause_line"
fi

# read_peak above already waited for the monitor's last word; the scratch file goes now.
if [ "$capped" = 1 ] && [ -n "$peek" ]; then
  rm -f "$peek" "$peek.tmp" 2>/dev/null
fi

if [ "$locked" = 1 ]; then
  log_event end " exit=$code"
fi

cleanup_scratch
exit "$code"
