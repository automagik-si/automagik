#!/bin/sh
# AUTOMAGIK_PNPM and the image's first pnpm: the shared admission lock and bounded env, then the
# runtime's real pnpm. The runtime .cjs is wrapped too for callers that invoke it through node.
exec /bin/sh /usr/local/bin/pnpm-admission /opt/automagik/runtime/node_modules/pnpm/bin/pnpm-real.cjs "$@"
