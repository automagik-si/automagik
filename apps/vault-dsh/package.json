    "dsh": ">=0.2.2-rc.2 <0.3.0-0",
    "node": ">=24.9"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "automagik": {
    "market": {
      "title": {
        "en": "Vault (Bitwarden)"
      },
      "description": {
        "en": "Read Bitwarden vault fields for approved Bot commands in DeepSeek Harness."
