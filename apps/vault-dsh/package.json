{
  "name": "@automagik/vault-dsh",
  "version": "3.160.4",
  "description": "Read Bitwarden vault fields for approved Bot commands in DeepSeek Harness.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "bitwarden",
    "vault"
  ],
  "homepage": "https://github.com/automagik-si/automagik/tree/dev/apps/vault-dsh#readme",
  "bugs": {
    "url": "https://github.com/automagik-si/automagik/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/automagik-si/automagik.git",
    "directory": "apps/vault-dsh"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
