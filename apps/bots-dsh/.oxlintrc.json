{
  "ignorePatterns": ["src/host/browser/script-child.js", "test/fixtures/supervisor-5b/**"],
  "env": { "browser": true, "node": true, "es2024": true },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": ["error", { "ignoreRestSiblings": true }]
  },
  "overrides": [{
    "files": ["src/decisions/**"],
    "rules": {
      "no-restricted-imports": ["error", {
        "patterns": [{
          "group": ["../host/*", "./host/*", "../../**/host/*"],
          "message": "Decisions must stay independent of the Bot host."
        }]
      }]
    }
  }]
}
